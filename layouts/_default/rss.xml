{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/"><channel><title>{{ site.Params.title }}</title><description>{{ site.Params.subtitle }}</description><link>{{ site.BaseURL }}</link><language>{{ site.Params.lang }}</language>{{- range where site.RegularPages "Section" "posts" }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid isPermaLink="true">{{ .Permalink }}</guid><description>{{ .Params.description }}</description><pubDate>{{ .Date.UTC.Format "Mon, 02 Jan 2006 15:04:05 GMT" }}</pubDate><content:encoded>{{ printf "<![CDATA[" | safeHTML }}{{ .Content }}]]></content:encoded></item>{{- end }}</channel></rss>
